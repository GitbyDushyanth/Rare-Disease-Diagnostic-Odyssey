# LUMEN Frontend
# Copy this file to .env and replace placeholders as needed.

# Browser -> Node API Gateway
# Local development uses the Vite proxy, so /api/v1 is usually correct.
VITE_API_URL=/api/v1

# Vite dev-server proxy target for /api/* requests.
VITE_API_PROXY_TARGET=http://localhost:3001

# Optional public key shown in the Research Portal API Access panel.
# Do not put private server API keys in VITE_* variables.
VITE_RESEARCH_API_KEY=lm_demo_replace_with_real_key

# Optional deployment metadata
VITE_APP_NAME=LUMEN
VITE_APP_ENV=development
