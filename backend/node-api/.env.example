# LUMEN Node API Gateway
# Copy this file to .env and replace placeholders before production use.

# Server
NODE_ENV=development
PORT=3001
API_VERSION=v1
PUBLIC_API_URL=http://localhost:3001

# Frontend / CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL / Supabase
# Use a pooled URL for app runtime and a direct/session URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# JWT
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_REFRESH_EXPIRES_IN=30d

# Python AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=250
GENOMIC_UPLOAD_DIR=./uploads/genomics
MAX_GENOMIC_FILE_SIZE_GB=5

# Optional object storage provider for future production uploads
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=lumen-documents
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=lumen-documents

# Optional external clinical APIs
CLINICAL_TRIALS_API_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICAL_TRIALS_API_KEY=
FHIR_BASE_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_TOKEN_URL=
FHIR_AUDIENCE=

# Optional notification/email/SMS providers
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lumen.health
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/lumen-api.log
