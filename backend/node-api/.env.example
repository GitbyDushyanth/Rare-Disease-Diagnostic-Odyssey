# ─────────────────────────────────────────────────────────────
# LUMEN Node.js API Gateway — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ── Database (Postgre via Supabase) ─────────────────────────────────
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.xdrfecwoafqvaplwjmyp:NameSpace_09_@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.xdrfecwoafqvaplwjmyp:NameSpace_09_@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ── AI Service (Python FastAPI) ───────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=250

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=./logs/lumen-api.log
