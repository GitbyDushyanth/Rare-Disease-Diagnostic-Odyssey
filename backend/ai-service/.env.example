# LUMEN AI Service
# Copy this file to .env and replace placeholders as needed.

# Server
HOST=0.0.0.0
PORT=8000
ENV=development
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# OpenAI-compatible provider
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# Keep true while developing without a live AI key.
# When true and OPENAI_API_KEY is missing/placeholder, endpoints return demo-shaped data instead of failing.
AI_FALLBACK_MODE=true

# Optional alternative provider placeholders for future adapters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional external clinical/research APIs
CLINICAL_TRIALS_API_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICAL_TRIALS_API_KEY=
HPO_API_BASE_URL=https://ontology.jax.org/api
ORPHANET_API_BASE_URL=
OMIM_API_KEY=
CLINVAR_API_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=

# Node API callback URL
NODE_API_URL=http://localhost:3001

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=info
